rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- helpers for Games & friends ----
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function isFriend(a, b) { return exists(/databases/$(database)/documents/friendships/$(pair(a, b))); }

    match /users/{uid}/sets/{setId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.keys().size() <= 10;
    }
    match /users/{uid}/prefs/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().size() <= 25;
    }
    // Read-only share links: anyone with the (unguessable) link can get one document; nobody can list them
    match /shared/{shareId} {
      allow get: if resource.data.expires == null || resource.data.expires > request.time.toMillis();
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.keys().size() <= 12;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.keys().size() <= 12;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // Feedback: signed-in users can send a message; only you can read it (in the Firebase console)
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().size() <= 8
        && request.resource.data.type in ["bug", "idea", "confusing", "other"]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1500
        && (!("info" in request.resource.data) || request.resource.data.info.size() <= 600)
        && (!("contact" in request.resource.data) || request.resource.data.contact.size() <= 150);
      allow read, update, delete: if false;
    }
    // ---- Games & friends (opt-in) ----
    // A profile holds only a nickname, an avatar and a friend code. Anyone signed in can read ONE profile if they know the id, but nobody can list or search profiles.
    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().size() <= 6
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 3 && request.resource.data.nick.size() <= 16
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && request.resource.data.code is string && request.resource.data.code.size() == 8;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // A friend code maps to a user id. It can be looked up one at a time, never listed.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.size() == 8
        && request.resource.data.uid == request.auth.uid && request.resource.data.keys().size() <= 2;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // A friend request, document id = sender + "_" + recipient. Blocked senders are refused.
    match /friendReq/{rid} {
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.keys().size() <= 6
        && request.resource.data.fromNick is string && request.resource.data.fromNick.size() <= 16
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.auth.uid));
      allow get, list, delete: if request.auth != null
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // A friendship can only be created by the person who received a request from the other member.
    match /friendships/{fid} {
      allow get, list, delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && fid == pair(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.keys().size() <= 3
        && exists(/databases/$(database)/documents/friendReq/$((request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]) + '_' + request.auth.uid));
    }
    // Blocks are private to the person who blocked.
    match /blocks/{bid} {
      allow create: if request.auth != null && request.resource.data.blocker == request.auth.uid
        && bid == request.auth.uid + '_' + request.resource.data.blocked && request.resource.data.keys().size() <= 3;
      allow get, list, delete: if request.auth != null && resource.data.blocker == request.auth.uid;
    }
    // A challenge is visible only to its members (the owner plus up to 3 of the owner's friends).
    // Each member may only write their own score, at most 3 tries, never above the stated maximum, and not after it expires.
    match /challenges/{cid} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 4
        && request.resource.data.members[0] == request.auth.uid
        && isFriend(request.auth.uid, request.resource.data.members[1])
        && (request.resource.data.members.size() < 3 || isFriend(request.auth.uid, request.resource.data.members[2]))
        && (request.resource.data.members.size() < 4 || isFriend(request.auth.uid, request.resource.data.members[3]))
        && request.resource.data.game in ['speed', 'match']
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 40
        && request.resource.data.max is number && request.resource.data.max <= 10000
        && request.resource.data.expires is number && request.resource.data.expires <= request.time.toMillis() + 2592000000
        && request.resource.data.scores == {}
        && request.resource.data.keys().size() <= 12;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid])
        && request.time.toMillis() < resource.data.expires
        && request.resource.data.scores[request.auth.uid].best is number
        && request.resource.data.scores[request.auth.uid].best >= 0
        && request.resource.data.scores[request.auth.uid].best <= resource.data.max
        && request.resource.data.scores[request.auth.uid].tries is number
        && request.resource.data.scores[request.auth.uid].tries <= 3
        && request.resource.data.scores[request.auth.uid].nick is string
        && request.resource.data.scores[request.auth.uid].nick.size() <= 16;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // A duel is a 1-versus-1 quiz fight between two friends. Each player may only write their own moves.
    match /duels/{did} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && request.resource.data.a == request.auth.uid
        && request.resource.data.b is string && request.resource.data.b != request.auth.uid
        && request.resource.data.players == [request.auth.uid, request.resource.data.b]
        && isFriend(request.auth.uid, request.resource.data.b)
        && request.resource.data.items is list && request.resource.data.items.size() <= 12
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.expires is number && request.resource.data.expires <= request.time.toMillis() + 1209600000
        && request.resource.data.movesA == {} && request.resource.data.movesB == {}
        && request.resource.data.keys().size() <= 16;
      allow update: if request.auth != null && request.time.toMillis() < resource.data.expires
        && ((resource.data.a == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['movesA']) && request.resource.data.movesA.size() <= 12)
         || (resource.data.b == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['movesB']) && request.resource.data.movesB.size() <= 12));
      allow delete: if request.auth != null && resource.data.a == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
